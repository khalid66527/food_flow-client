# ==============================================================================
# FoodFlow Client Environment Variables - DUMMY SAMPLE FILE ONLY
# Copy this file to '.env' and fill in your actual private credentials.
# DO NOT put real API keys or passwords in this example file.
# ==============================================================================

# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/food-delivery-platform?retryWrites=true&w=majority
DB_NAME=food-delivery-platform

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret_32_chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# High-Deliverability Email API Services (Optional - Bypasses SMTP for Direct Inbox Delivery)
# 1. Resend API
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# 2. SendGrid API
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=support@yourdomain.com

# 3. Gmail / Custom SMTP Fallback
EMAIL_FROM=support.foodflow@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Image Upload
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

# Stripe Online Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Backend Server
NEXT_PUBLIC_SERVER_API_URL=http://localhost:5000
